                                </p>

                                <div class="flex flex-column">
                                    <div class="ratio-1x1 rounded-circle overflow-hidden mx-auto mb-2"
                                         style="width: 80px">
                                        <img
                                            src="https://tracuuthansohoc.com/wp-content/uploads/2022/10/nam-20220810073543-1-80x80.png"
                                            alt="Junes"/>
                                    </div>

                                    <p class="fw-normal"><strong>Junes</strong><br/>Designer &amp; MC</p>
                                </div>
                            </div>
                        </div>
                    </div>

                </div>
            </div>
        </div>
    </div>

    <style>
        /* Make sure the container has enough height to show the background and slides */
        .slider-background {
            background: url('assets/bg_customer.webp') no-repeat center center;
            background-size: cover;
            position: relative;
            padding: 40px 0 10px;
        }

        /* Position the slick slider content above the overlay */
        .slider-container {
            position: relative;
            z-index: 2;
        }

        .slider {
            /* Optional: center text, etc. */
            text-align: center;
        }

        /* Basic styling for each slide's text block */
        .slider .slide-content {
            margin: 0 auto;
            padding-inline: 40px;
            height: 400px;
            display: flex;
            justify-content: space-between;
            flex-direction: column;
            overflow: hidden;
            font-weight: 600;
            line-height: 2rem;
        }

        h2, p {
            margin-bottom: 1.5rem;
        }

        .slider .slick-arrow {
            border: solid 3px #333;
            border-radius: 50%;
            background-color: transparent;
            width: 32px;
            height: auto;
            aspect-ratio: 1/1;
            color: black;
            transition: left 300ms, right 300ms;

            &:hover {
                color: var(--main-color);
                border-color: var(--main-color);
            }

            &:before {
                font-family: unset;
                font-weight: 700;
                color: inherit;
            }

            &.slick-prev {
                left: -72px;

                &:hover {
                    left: -80px;
                }

                &:before {
                    content: "<";
                }
            }

            &.slick-next {
                right: -72px;

                &:hover {
                    right: -80px;
                }

                &:before {
                    content: ">";
                }
            }
        }
    </style>

    @await Html.PartialAsync("_TshWheel")
</div>