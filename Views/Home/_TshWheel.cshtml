<div class="container p-4 d-none d-md-flex">
    <div class="d-flex flex-row align-items-start gap-4">
        <!-- Chart Section -->
        <div class="position-relative" style="width: 450px; height: 450px;">
            <!-- Center Image -->
            <div
                style="
                        position: absolute;
                        width: 138px;
                        height: 138px;
                        left: 50%;
                        top: 50%;
                        transform: translate(-50%, -50%);
                        border-radius: 50%;
                        z-index: 1;
                        cursor: pointer;
                    "
            >
                <img
                    src="~/assets/number/22b.png"
                    alt="Center"
                    style="
                            width: 100%;
                            height: 100%;
                            object-fit: cover;
                            border-radius: 50%;
                            transition: all 0.3s ease;
                        "
                />
            </div>

            <!-- Images around the circle 
            In React, you used numberInfo.map. In Razor, 
            you could loop over a model collection if you want dynamic items.
            -->
            @for (var i = 0; i < numberInfo.Length; i++)
            {
                var angle = i * (360 / 10) - 90;
                var radians = angle * (Math.PI / 180);
                const int radius = 140; // Radius mới

                var x = Math.Cos(radians) * radius;
                var y = Math.Sin(radians) * radius;

                <div
                    style="@(
                           $"position: absolute;width: 120px;height: 120px;transform: translate({x}px, {y}px);left: 50%;top: 50%;margin-left: -60px;margin-top: -60px;cursor: pointer;"
                           )"
                >
                    <div
                        style="@($"width: 100%;height: 100%;display: flex;justify-content: center;align-items: center;transition: all 0.3s ease;transform: rotate({angle + 90}deg);")"
                    >
                        <img
                            src="@(numberInfo[i].image)"
                            alt="Image 1"
                            style="
                                width: 100%;
                                height: 100%;
                                object-fit: contain;
                                transition: all 0.3s ease;
                            "
                        />
                    </div>
                </div>
            }

            <!-- Repeat for each position around the circle as necessary -->
        </div>

        <!-- Description Section (Desktop) -->
        <div class="flex-fill" style="max-width: 700px;">
            <h2 class="fs-2 fw-bold mb-4">
                Ý NGHĨA CÁC CON SỐ TRONG THẦN SỐ HỌC PITAGO
            </h2>

            <!-- 
              In React, selectedIndex controls which text to show. In Razor, 
              you'd normally check Model.SelectedIndex or something similar.
            -->
            <p style="font-size: 16px; line-height: 1.6; color: #666;">
                22 là một trong bộ ba số quan trọng trong Nhân số học (11, 22, 33).
                Theo đó, cả 3 số này được liên kết với nhau và tạo thành
                "Tam giác của sự khai sáng"...
            </p>

            <button
                class="btn"
                style="
                        background-color: #C84B9B;
                        color: #fff;
                        padding: 12px 24px;
                        border: none;
                        border-radius: 5px;
                        font-size: 16px;
                        cursor: pointer;
                        margin-top: 20px;
                        transition: background-color 0.3s;
                    "
            >
                XEM CHI TIẾT
            </button>
        </div>
    </div>
</div>